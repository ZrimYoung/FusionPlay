<Window x:Class="FusionPlay.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FusionPlay.Windows" xmlns:platform="using:FusionPlay.Windows.Platform" Title="FusionPlay">
 <local:PlayerRootGrid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyboardAcceleratorPlacementMode="Hidden" SizeChanged="Root_SizeChanged" PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited" GotFocus="Root_GotFocus" LostFocus="Root_LostFocus">
  <Grid.ContextFlyout>
   <MenuFlyout Opening="PlayerMenu_Opening">
    <MenuFlyoutItem x:Name="FullScreenMenuItem" Click="FullScreen_Click" Text="全屏" KeyboardAcceleratorTextOverride="F11"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="CopyTrackTitleMenuItem" Click="CopyTrackTitle_Click" Text="复制歌名"/>
    <MenuFlyoutItem x:Name="CopyTrackInfoMenuItem" Click="CopyTrackInfo_Click" Text="复制曲目信息" KeyboardAcceleratorTextOverride="Ctrl+C"/>
   </MenuFlyout>
  </Grid.ContextFlyout>
  <Grid x:Name="SceneBacking" IsHitTestVisible="False" Background="#FF152136" Visibility="Collapsed"><Grid x:Name="SceneBackingLayer"/><Border x:Name="SceneBackingShade"/></Grid>
  <Grid x:Name="ExpandedRoot" Visibility="Collapsed">
   <Grid x:Name="BackdropLayer" IsHitTestVisible="False"/><Grid x:Name="ExpandedLyricsBackground" IsHitTestVisible="False"/><Border x:Name="BackdropShade" Background="#99000000" IsHitTestVisible="False"/>
   <Grid x:Name="ExpandedContent" Padding="28,14,28,22" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="ExpandedHeader">
     <StackPanel x:Name="ExpandedBrand" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="FusionPlay" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" FontSize="12" Opacity="0.65" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4"><Button x:Name="LyricsToggleButton" Click="LyricsToggle_Click" Background="Transparent" BorderThickness="0" Visibility="Collapsed"><FontIcon x:Name="LyricsToggleIcon" Glyph="&#xE8BD;" FontSize="16"/></Button><Button x:Name="SettingsButton" Click="Settings_Click" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button><Button x:Name="ExpandedFullScreenButton" Click="FullScreen_Click" Background="Transparent" BorderThickness="0"><FontIcon x:Name="ExpandedFullScreenIcon" Glyph="&#xE740;" FontSize="16"/></Button><Button x:Name="ExpandedCloseButton" Click="Close_Click" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE8BB;" FontSize="14"/></Button></StackPanel>
    </Grid>
    <Grid x:Name="PlayerLayout" Grid.Row="1" ColumnSpacing="28" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="CoverFrame" Width="230" Height="230" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid><FontIcon x:Name="CoverPlaceholder" Glyph="&#xEC4F;" FontSize="72" Opacity="0.18"/><Image x:Name="PreviousCoverImage" Stretch="UniformToFill" IsHitTestVisible="False"/><Image x:Name="CoverImage" Stretch="UniformToFill" AutomationProperties.Name="专辑封面"/></Grid></Border>
     <Grid x:Name="ExpandedDetails" Grid.Column="1" RowSpacing="12" VerticalAlignment="Stretch">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="ExpandedMetadata" Spacing="7" VerticalAlignment="Top"><local:PlayerText x:Name="TitleText" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><local:PlayerText x:Name="ArtistText" FontSize="14" Foreground="{ThemeResource PlayerSecondaryTextBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Row="1" x:Name="ProgressPanel" Spacing="5" Visibility="Collapsed"><platform:ProgressSeekButton x:Name="ProgressSeek"><platform:PlayerProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="3" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/></platform:ProgressSeekButton><Grid><local:PlayerText x:Name="PositionText" FontSize="12" Foreground="{ThemeResource PlayerSecondaryTextBrush}"/><local:PlayerText x:Name="DurationText" FontSize="12" Foreground="{ThemeResource PlayerSecondaryTextBrush}" HorizontalAlignment="Right"/></Grid></StackPanel>
      <StackPanel Grid.Row="2" x:Name="TransportPanel" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center"><Button x:Name="PreviousButton" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Previous_Click" Width="40" Height="40" Background="Transparent" BorderThickness="0"><PathIcon x:Name="PreviousIcon" Width="19" Height="19"/></Button><Button x:Name="PlayButton" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Play_Click" Width="52" Height="52" CornerRadius="26"><platform:PlayPauseGlyph x:Name="PlayIcon"/></Button><Button x:Name="NextButton" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Next_Click" Width="40" Height="40" Background="Transparent" BorderThickness="0"><PathIcon x:Name="NextIcon" Width="19" Height="19"/></Button></StackPanel>
      <Grid x:Name="VolumeRow" Grid.Row="3" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE992;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/><Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" StepFrequency="1" ValueChanged="Volume_Changed"/><FontIcon Grid.Column="2" Glyph="&#xE995;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/></Grid>
     </Grid>
     <Grid x:Name="ExpandedLyricsHost" Grid.Column="1" Grid.RowSpan="2" Visibility="Collapsed"/>
    </Grid>
    <StackPanel x:Name="ExpandedFooter" Grid.Row="2" Spacing="6"><Button x:Name="ExpandedMigrationButton" Visibility="Collapsed" Click="Migration_Click" HorizontalAlignment="Left"/><TextBlock x:Name="ExpandedStatus" FontSize="12" TextWrapping="Wrap" MaxLines="2" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   </Grid>
  </Grid>
  <Grid x:Name="MiniRoot" Background="#FF152136" RequestedTheme="Dark">
   <Grid.RowDefinitions><RowDefinition x:Name="MiniCoverRow" Height="*"/><RowDefinition x:Name="MiniLyricsGapRow" Height="0"/><RowDefinition x:Name="MiniLyricsRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="MiniLyricsBackground" Grid.RowSpan="3" IsHitTestVisible="False"/>
   <Border x:Name="MiniLyricsGlobalShade" Grid.RowSpan="3" IsHitTestVisible="False" Visibility="Collapsed"/>
   <Grid x:Name="MiniCoverPanel">
   <Grid x:Name="MiniArtworkLayer"><FontIcon x:Name="MiniPlaceholder" Glyph="&#xEC4F;" FontSize="90" Opacity="0.2"/><Image x:Name="MiniPreviousCover" Stretch="UniformToFill" IsHitTestVisible="False"/><Image x:Name="MiniCover" Stretch="UniformToFill" AutomationProperties.Name="专辑封面" IsHitTestVisible="False"/><Grid x:Name="LoadingArtworkLayer" IsHitTestVisible="False"/></Grid>
   <Grid x:Name="MiniCoverEffects" IsHitTestVisible="False">
   <Grid x:Name="MiniBackdropLayer" IsHitTestVisible="False"/>
   <Border x:Name="MiniShade" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.4"/><GradientStop Color="#99000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   </Grid>
   <Grid x:Name="MiniControlsTransitionLayer" VerticalAlignment="Bottom">
   <StackPanel x:Name="MiniControls" VerticalAlignment="Bottom" Padding="18,20,18,14" Spacing="6" SizeChanged="MiniControls_SizeChanged">
    <local:PlayerText x:Name="MiniTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><local:PlayerText x:Name="MiniArtist" FontSize="14" Foreground="{ThemeResource PlayerSecondaryTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
    <Button x:Name="AlbumLyricSummary" Click="AlbumLyricSummary_Click" Visibility="Collapsed" MinHeight="34"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="9,5"
            Margin="0,6,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0">
     <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="AlbumLyricSummaryText" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
      <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11" Opacity="0.65" AutomationProperties.AccessibilityView="Raw"/>
     </Grid>
    </Button>
    <StackPanel x:Name="MiniProgressPanel" Spacing="4" Margin="0,4,0,0"><platform:ProgressSeekButton x:Name="MiniProgressSeek"><platform:PlayerProgressBar x:Name="MiniProgress" Minimum="0" Maximum="100" Height="3" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/></platform:ProgressSeekButton><Grid><local:PlayerText x:Name="MiniPosition" FontSize="12" Foreground="{ThemeResource PlayerSecondaryTextBrush}"/><local:PlayerText x:Name="MiniDuration" FontSize="12" Foreground="{ThemeResource PlayerSecondaryTextBrush}" HorizontalAlignment="Right"/></Grid></StackPanel>
    <StackPanel x:Name="MiniTransport" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center"><Button x:Name="MiniPreviousButton" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Previous_Click" Width="36" Height="36" Background="Transparent" BorderThickness="0"><PathIcon x:Name="MiniPreviousIcon" Width="18" Height="18"/></Button><Button x:Name="MiniPlayButton" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Play_Click" Width="44" Height="44" CornerRadius="22" Background="#60FFFFFF" BorderThickness="0"><platform:PlayPauseGlyph x:Name="MiniPlayIcon"/></Button><Button x:Name="MiniNextButton" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Next_Click" Width="36" Height="36" Background="Transparent" BorderThickness="0"><PathIcon x:Name="MiniNextIcon" Width="18" Height="18"/></Button></StackPanel>
    <Button x:Name="MigrationButton" Visibility="Collapsed" Click="Migration_Click" HorizontalAlignment="Left"/><TextBlock x:Name="MiniStatus" FontSize="11" TextWrapping="Wrap" MaxLines="2" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
   </Grid>
   <ScrollViewer x:Name="MiniAlbumScroll" Visibility="Collapsed" Margin="0,44,0,0" Padding="0,0,0,24"
                 HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                 VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
    <StackPanel x:Name="MiniAlbumColumn" Spacing="16" HorizontalAlignment="Center">
     <Border x:Name="MiniAlbumArtworkFrame" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </StackPanel>
   </ScrollViewer>
   </Grid>
   <Grid x:Name="MiniLyricsHost" Grid.Row="2" MinHeight="128" Padding="22,0,22,12" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="AlbumLyricsHeader" Click="AlbumLyricsHeader_Click" Visibility="Collapsed"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,4" Margin="0,0,0,6"
            MinHeight="44" Background="Transparent" BorderThickness="0">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="AlbumLyricsArtworkFrame" Width="52" Height="52" CornerRadius="6"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.AccessibilityView="Raw">
       <Grid>
        <FontIcon Glyph="&#xEC4F;" Opacity="0.25" FontSize="20"/>
        <Image x:Name="AlbumLyricsArtwork" Stretch="UniformToFill" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <StackPanel x:Name="AlbumLyricsMetadata" Grid.Column="1" Spacing="2" VerticalAlignment="Center">
       <TextBlock x:Name="AlbumLyricsTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
       <TextBlock x:Name="AlbumLyricsArtist" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxLines="1"/>
      </StackPanel>
      <FontIcon Grid.Column="2" Glyph="&#xE72B;" FontSize="14" Opacity="0.65" AutomationProperties.AccessibilityView="Raw"/>
     </Grid>
    </Button>
   </Grid>
   <Grid x:Name="MiniActions" Canvas.ZIndex="2" VerticalAlignment="Top" Margin="8">
    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
     <Button x:Name="MiniFullScreenButton" Click="FullScreen_Click" Width="30" Height="28" Padding="0" Background="#55202020" BorderThickness="0"><FontIcon x:Name="MiniFullScreenIcon" Glyph="&#xE740;" FontSize="13"/></Button>
     <Button x:Name="CloseButton" Click="Close_Click" Width="30" Height="28" Padding="0" Background="#55202020" BorderThickness="0"><FontIcon Glyph="&#xE8BB;" FontSize="12"/></Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
     <Button x:Name="MiniLyricsToggleButton" Click="LyricsToggle_Click" Width="30" Height="28" Padding="0" Background="#55202020" BorderThickness="0" Visibility="Collapsed"><FontIcon x:Name="MiniLyricsToggleIcon" Glyph="&#xE8BD;" FontSize="13"/></Button>
     <Button x:Name="PinButton" Click="Pin_Click" Width="30" Height="28" Padding="0" Background="#55202020" BorderThickness="0"><FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="15"/></Button>
    </StackPanel>
   </Grid>
  </Grid>
  <FontIcon x:Name="IdlePlaceholder" Glyph="&#xEC4F;" FontSize="64" Opacity="0.24" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
  <Border x:Name="CoverResizeHint" Width="34" Height="5" Margin="0,0,0,6"
          HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="3"
          Background="#FFFFFFFF" BorderBrush="#66000000" BorderThickness="1" Opacity="0"
          IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
 </local:PlayerRootGrid>
</Window>
