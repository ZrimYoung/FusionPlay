<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FusionPlay.Core\FusionPlay.Core.csproj" />
    <Content Include="$(FusionPlayNativeDir)\fusionplay_host.dll" Condition="Exists('$(FusionPlayNativeDir)\fusionplay_host.dll')" Link="fusionplay_host.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
